# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# eval — the latest report regenerates on every run; baselines.json is committed
/eval/report.json
# Same for the judge-quality run: fixtures + runner are committed, the live
# per-run numbers are not (they cost ~48 Gemini calls to reproduce on demand).
/eval/judge/report.json
# Captured OTel span dumps from voice sessions (input to latency-report).
# Sample dumps for the README go in docs/observability-samples/ instead.
/eval/sessions/
*.spans.jsonl

# Security audit per-run JSON dumps (input to baseline-recorded comparison).
# Baseline file (security_baseline.json at repo root) IS committed.
/livekit-agent/security_audit_*.json

# Personal resume + LaTeX build artifacts at repo root — never commit
/cv.aux
/cv.log
/cv.out
/cv.pdf
/cv.tex
/cv.txt

# SDD execution scratch (progress ledger, task briefs)
/.superpowers/

# Owner's personal interview-prep material — kept locally, never published.
/docs/interview-prep-archive/
