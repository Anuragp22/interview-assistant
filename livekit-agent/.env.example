# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech / LLM providers
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
# Groq powers the LLM (OpenAI-compatible endpoint). Get a key at
# https://console.groq.com/keys
GROQ_API_KEY=
# Optional override; defaults to openai/gpt-oss-120b.
# GROQ_MODEL=openai/gpt-oss-120b

# Firebase Admin — pick ONE of the following two options:
#
# (A) Base64-encoded service-account JSON, single secret.
#     Recommended for production deploys (Render/Fly/etc.).
# FIREBASE_SERVICE_ACCOUNT_JSON=
#
# (B) The same three discrete fields the Next.js side uses
#     (firebase/admin.ts). Convenient in dev when you share a single
#     repo-root .env.local across both processes — the agent picks
#     these up automatically.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# OpenTelemetry — optional. Unset means spans print to stdout.
#
# Langfuse is the zero-config path: set both keys, the endpoint is
# derived. Free tier at cloud.langfuse.com; it groups the spans by the
# gen_ai.* attributes they already carry.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# Only for a non-EU region or self-hosted. Default https://cloud.langfuse.com.
# LANGFUSE_HOST=https://cloud.langfuse.com
#
# An explicit OTLP endpoint (Honeycomb, Tempo, a collector) ALWAYS wins
# over the Langfuse keys above.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io/v1/traces
# HONEYCOMB_API_KEY=
# HONEYCOMB_DATASET=interview-assistant
#
# In dev the agent reads the repo-root .env.local first, then this file
# (which wins) — so you usually set the above in ONE place, not both.

# Turn-taking is NOT env-configurable. The values live in
# pipeline.py:_INTERVIEW_TURN_HANDLING, next to the reasoning for each one —
# they are interview-design decisions, not deployment knobs, and tuning them
# blind via env would be a way to silently make the agent talk over candidates.

# Where the Next.js app lives, so the agent can trigger scoring when a call
# ends (e.g. https://your-app.vercel.app, or http://localhost:3000 in dev).
# If unset, the agent still marks the session awaiting-report and the cron
# reconciler generates the report on its next tick — just less promptly.
WEB_APP_URL=

# Must match INTERNAL_API_SECRET in the Next.js app's env.
INTERNAL_API_SECRET=
