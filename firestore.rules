rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Users — owners read/write their own profile (incl. saved CV).
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Templates — the question/rubric set a session is generated from.
    // Practice is self-service, so ownerUid is the practising user.
    match /templates/{templateId} {
      allow read, update, delete: if isOwner(resource.data.hrUid);
      allow create: if isOwner(request.resource.data.hrUid);
    }

    // Sessions — owner-only read. All mutations go through server actions
    // and the Python agent using the Admin SDK, which bypasses these rules.
    match /sessions/{sessionId} {
      allow read: if isOwner(resource.data.candidateUid);
      allow write: if false;   // server-only via Admin SDK
    }

    // Turn data — inherits the parent session's access rule.
    match /sessions/{sessionId}/turns/{turnId} {
      allow read: if
        isOwner(get(/databases/$(database)/documents/sessions/$(sessionId)).data.candidateUid);
      allow write: if false;
    }

    // Reports — owner of the parent session. Written server-side only:
    // a candidate must never be able to write their own score.
    match /reports/{sessionId} {
      allow read: if
        isOwner(get(/databases/$(database)/documents/sessions/$(sessionId)).data.candidateUid);
      allow write: if false;
    }
  }
}
