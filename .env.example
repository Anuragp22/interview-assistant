# Firebase Configuration (Client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Configuration (Admin)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Groq — used by both the LLM in /api/interviews/generate (question
# generation) and createFeedback (Zod-structured scoring). Same key the
# Python agent uses for the live conversation LLM.
GROQ_API_KEY=
# Optional: up to 3 SEPARATE Groq accounts for failover. Groq's free tier
# caps tokens-per-day per ACCOUNT, so 3 accounts ~= 3x the daily budget.
# The TS LLM calls and the Python audit rotate across these on a
# 429/daily-quota error. Any subset works; the legacy GROQ_API_KEY above
# also counts as one account.
GROQ_API_KEY1=
GROQ_API_KEY2=
GROQ_API_KEY3=
# Optional override; defaults to openai/gpt-oss-120b.
# GROQ_MODEL=openai/gpt-oss-120b

# LiveKit (replaces VAPI)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Speech / TTS providers (used by the Python agent — read here too because
# the agent loads this same .env.local in dev)
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=

# OpenTelemetry — optional. Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to
# fall back to console exporter (spans dump to stdout). To ship traces
# to Honeycomb: get a free API key at honeycomb.io, set the two vars
# below. Other OTLP backends (Grafana Cloud Tempo, Jaeger, OpenTelemetry
# Collector) work the same way — point OTEL_EXPORTER_OTLP_ENDPOINT at
# their /v1/traces endpoint and drop the Honeycomb-specific headers.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io/v1/traces
# HONEYCOMB_API_KEY=
# HONEYCOMB_DATASET=interview-assistant
#
# Optional offline capture: when OTEL_TRACES_FILE is set, the Python
# agent writes every span as a one-per-line JSON object to this file
# (alongside the primary backend). Feed it into `npm run latency-report`
# to get per-leg p50/p95/p99 with budget verdicts. See docs/observability.md.
# OTEL_TRACES_FILE=eval/sessions/local.spans.jsonl

# ---------------------------------------------------------------------------
# Judge (Gemini) — scores the interview.
#
# Deliberately a DIFFERENT model family from the interviewer (Groq gpt-oss-120b).
# If one model holds a wrong belief it will both fail to probe a candidate's
# correct answer and then mark that answer wrong when grading. The error lives in
# the weights, so a fresh stateless call does not fix it — only a different family
# does. Scoring is offline, so this model is picked for reasoning, not speed.
#
# BILLING MUST BE ENABLED. Google's FREE tier uses submitted content to improve
# their products, and this call carries candidate CVs and interview transcripts.
# On the paid tier your data is not used for training, and you can drop log
# retention to 7 days in AI Studio. Cost is ~$0.35 per 100 interviews.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# JUDGE_MODEL=gemini-3.1-flash-lite   # optional override

# ---------------------------------------------------------------------------
# Internal service-to-service auth.
#
# The Python agent calls /api/internal/score when a call ends, so the report is
# ready by the time the candidate lands on the report page. The agent has no
# Firebase session cookie (it's a worker, not a user), so this shared bearer
# secret is how it authenticates. Must match livekit-agent/.env.
# Generate: openssl rand -hex 32
INTERNAL_API_SECRET=

# Vercel Cron auth for /api/internal/reconcile, which sweeps up any session
# whose scoring hand-off was lost (worker OOM, deploy mid-call, network drop).
# This is what makes report generation a guarantee rather than best-effort.
# Set the same value in the Vercel project's env vars.
CRON_SECRET=
